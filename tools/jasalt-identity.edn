;; The three scenes carried from jasalt/jolt-android-experiment at 6d2b291. The
;; other three namespaces from that experiment (the gallery's core, ui and
;; diagnostics) stay in raylib-ios, which keeps their rows.
;;
;; :file       where this repo keeps it.
;; :upstream   the path it has upstream.
;; :ns         each namespace name used here -> the name upstream has.
;; :notebook-sha  what the glimmer-ios-demo notebooks recorded for the upstream
;;             bytes: the full sha256, or its first 16 hex digits where the
;;             notebooks kept only a prefix.
;; :sha        sha256 of the upstream file at 5b14eb3, the first commit that
;;             carried it, after jasalt-identity/normalise (tools/jasalt_identity.clj):
;;             runs of whitespace become one space and the spaces beside a
;;             bracket go. At 5b14eb3 :notebook-sha matches the raw bytes. Two of
;;             the three have been through clojure-lsp format since, which only
;;             moves layout, so the raw hash no longer matches them and this one
;;             does. A changed string or a merged token still changes it.
;;
;; The identity test puts the upstream names back into :file, normalises and
;; compares with :sha.
[{:file     "flappy-bird/src/net/b12n/raylib_ios/scenes/flappy_bird.cljc"
  :upstream "src/poc/raylib/flappy_bird.cljc"
  :notebook-sha "4d9cf3ae1984613d2e0a4fc25269e147d09e3562d57e12743233b38610a8c560"
  :sha      "e2ba05d7774eb1054531b27da066f7c1c7daaa0348fcc7ea929ab992983b34a7"
  :ns       {net.b12n.raylib-ios.scenes.flappy-bird poc.raylib.flappy-bird}}
 {:file     "eyes/src/net/b12n/raylib_ios/scenes/following_eyes.cljc"
  :upstream "src/poc/raylib/following_eyes.cljc"
  :notebook-sha "9dcd98e36aafcb78"
  :sha      "27ac6595a3511ece32ead33f0a0bfd07d8cffe1fd7beb7f3f19ee8031da4b4bf"
  :ns       {net.b12n.raylib-ios.scenes.following-eyes poc.raylib.following-eyes}}
 {:file     "mouse-trail/src/net/b12n/raylib_ios/scenes/touch_trail.cljc"
