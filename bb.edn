;; Task runner for raylib-ios-demo: the raylib examples as iPhone apps, one sub-project each.
;;
;; Run these from the repo root with EITHER `bb <task>` or `jolt <task>`. jolt
;; reads this file as well as deps.edn, so both runners see the same tasks.
;;
;;   bb info               grouped cheat-sheet, every scene included
;;   bb gallery            build the all-scenes app and install it on the phone
;;   bb <scene>            build one scene as an app of its own, e.g. bb asteroids
;;   bb run <scene>        the same, by argument (the scene id works too)
;;   bb live <scene>       the same scene with an nREPL on the phone (dev builds)
;;   bb proxy              another terminal, after a live build: the nREPL over USB
;;   bb list               flat list of scenes with descriptions
;;   bb test [scene]       the tests: every scene's, or one sub-project's
;;   bb check              load every app namespace, no window
;;   bb lint [--strict]    clj-kondo over every scene (lint:strict fails on findings)
;;   bb doctor             is jolt there, does raylib-ios resolve, is the toolchain present?
;;   bb gen [--check]      rebuild deps.edn, the sub-projects, the registry and these tasks
;;
;; Installing needs the phone's hardware udid in UDID (`jolt devices` lists it),
;; and a jolt that can build device images: see README.md.
;;
;; The scene list is demos.edn, edited by hand, and the per-scene tasks at the
;; bottom are written from it by `bb gen`.
;;
;; NOTE: task bodies are EDN-parsed. No #"regex", no @deref, no #(...).
{:min-bb-version "1.3.0"
 :paths ["scripts"]
 :tasks
 {:requires ([babashka.fs :as fs]
             [clojure.edn :as edn]
             [clojure.string :as str]
             [ios-tools])

  :init
  (do
    ;; bb sets babashka.version, jolt sets jolt.version.
    (def runner (if (System/getProperty "babashka.version") "bb" "jolt"))
    (def jolt-cmd (ios-tools/jolt-cmd))

    ;; [{:name :id :category :title :desc :from (:home)} ...], edited by hand.
    (def demos (if (fs/exists? "demos.edn") (edn/read-string (slurp "demos.edn")) []))
    (def scenes (remove :home demos))

    (defn find-scene [s]
      (first (filter (fn [d] (or (= s (:name d)) (= s (name (:id d))))) scenes)))

    (defn scene-or-die [s]
      (or (find-scene s)
          (do (binding [*out* *err*]
                (println (str "No scene named " s ". `" runner " list` shows them all.")))
              (System/exit 1))))

    (defn app-ns [d] (str "net.b12n.raylib-ios.scenes." (name (:id d)) ".app"))
    (defn live-ns [d] (str "net.b12n.raylib-ios.scenes." (name (:id d)) ".live"))

    (defn exit-with [exit] (ios-tools/exit-with exit))

    (defn run-scene [s]
      (let [d (scene-or-die s)] (ios-tools/run! (:name d) (app-ns d))))

    (defn live-scene [s]
      (let [d (scene-or-die s)] (ios-tools/live! (:name d) (live-ns d))))

    ;; Every source root clj-kondo should see: the shared code, the scripts, the
    ;; check namespace, the gallery and each scene listed in demos.edn.
    (defn lint-dirs []
      (filter fs/exists?
              (concat ["common/src" "src" "scripts" "gallery/src" "gallery/test"]
                      (mapcat (fn [d] [(str (:name d) "/src") (str (:name d) "/test")]) scenes))))

    (defn kondo! []
      (when-not (fs/which "clj-kondo")
        (binding [*out* *err*]
          (println "bb lint needs clj-kondo on PATH: https://github.com/clj-kondo/clj-kondo/blob/master/doc/install.md"))
        (System/exit 1))
      (:exit (apply shell {:continue true} "clj-kondo" "--lint" (lint-dirs)))))

  info
  {:doc "Grouped cheat-sheet, every scene included (start here)"
   :task
   (let [esc (str (char 27) "[")
         col (fn [c s] (str esc c "m" s esc "0m"))
         hdr (fn [s] (println (str "\n" (col "35" (str "── " s " ──")))))
         row (fn [t d] (println (str "  " (col "36" (format "%-32s" (str runner " " t))) d)))]
     (println (col "1;35" (str "\nraylib-ios-demo: " (count demos) " raylib scenes as iPhone apps, one sub-project each")))
     (println (col "2" (str "  runner: " runner "   ·   both `bb <task>` and `jolt <task>` work")))
     (hdr "Install on the phone (UDID=<hardware udid>)")
     (row "gallery" "all scenes in one app, behind a two-level menu")
     (row "<scene>" "one scene full screen as an app, e.g. asteroids")
     (row "run <scene>" "the same, by argument; the scene id works too")
     (row "live <scene>" "the same scene with an nREPL on the phone (dev)")
     (row "gallery:live" "the gallery with an nREPL on the phone (dev)")
     (row "proxy" "another terminal, after a live build: the nREPL over USB")
     (hdr "Look")
     (row "list" "flat list of scenes with descriptions")
     (hdr "Verify")
     (row "doctor" "check jolt, raylib-ios and the iOS toolchain")
     (row "test [scene]" "every scene's tests, or one sub-project's")
     (row "check" "load every app namespace, no window")
     (row "lint" "clj-kondo over every scene (report only); lint:strict fails on findings")
     (hdr "Maintenance")
     (row "gen [--check]" "rebuild deps.edn, sub-projects, registry and tasks from demos.edn")
     (doseq [[category title] [["generative" "Generative"] ["fractals" "Fractals"] ["toys" "Toys"] ["games" "Games"]]
             :let [ds (filter (fn [d] (= category (:category d))) demos)]]
       (hdr (str title " (" (count ds) ")"))
       (doseq [d ds]
         (row (if (:home d) (str (:name d) " (raylib-ios)") (:name d)) (or (:desc d) ""))))
     (println (str "\n" (col "2" (str "first run: " runner " doctor, then UDID=... " runner " asteroids")))))}

  list
  {:doc "Flat list of scenes with descriptions"
   :task (let [w (apply max (map (fn [d] (count (:name d))) demos))]
           (doseq [d demos]
             (println (format (str "%-" w "s  %-10s  %s") (:name d) (:category d) (or (:desc d) "")))))}

  run
  {:doc "Build one scene as an app and install it: run <scene>"
   :override-builtin true
   :task (if-let [name (first *command-line-args*)]
           (exit-with (run-scene name))
           (do (println (str "usage: " runner " run <scene>   (" runner " list shows them)"))
               (System/exit 1)))}

  live
  {:doc "A scene with an nREPL on the phone: live <scene>"
   :task (if-let [name (first *command-line-args*)]
           (exit-with (live-scene name))
           (do (println (str "usage: " runner " live <scene>   (" runner " list shows them)"))
               (System/exit 1)))}

  gallery
  {:doc "Build the all-scenes gallery app and install it"
   :task (exit-with (ios-tools/run! "gallery" "net.b12n.raylib-ios.demo.gallery.app"))}

  gallery:live
  {:doc "The gallery with an nREPL on the phone"
   :task (exit-with (ios-tools/live! "gallery" "net.b12n.raylib-ios.demo.gallery.live"))}

  proxy
  {:doc "Forward the phone's nREPL over USB, after bb live or bb gallery:live"
   :task (exit-with (ios-tools/proxy! "common"))}

  test
  {:doc "Every scene's tests, or one sub-project's: test [scene]"
   :task (if-let [name (first *command-line-args*)]
           (exit-with (ios-tools/test! (if (= name "gallery") "gallery" (:name (scene-or-die name)))))
           (exit-with (:exit (shell {:continue true} jolt-cmd "-M:test"))))}

  check
  {:doc "Load every app namespace, no window"
   :task (exit-with (:exit (shell {:continue true} jolt-cmd "-M:check")))}

  lint
  {:doc "clj-kondo over every scene (report only)"
   :task (let [exit (kondo!)]
           (println (if (zero? exit) "OK clj-kondo: no errors or warnings" "clj-kondo: see findings above")))}

  lint:strict
  {:doc "bb lint, but exit non-zero on any warning or error"
   :task (exit-with (kondo!))}

  doctor
  {:doc "Check jolt, raylib-ios and the iOS toolchain before anything else"
   :task (let [jolt? (fs/which jolt-cmd)
               ios-root (when jolt?
                          (try (ios-tools/raylib-ios-root "common")
                               (catch Exception _ nil)))
               ;; what a build needs, and what only a Mac with a phone has
               required [["jolt on PATH" jolt? "install jolt: https://github.com/jolt-lang/jolt"]
                         ["raylib-ios with tools/ios (resolved from common/deps.edn)" ios-root
                          "common/deps.edn: does net.b12n/raylib-ios resolve? A :local/root needs the checkout beside this one."]
                         ["demos.edn" (fs/exists? "demos.edn") "restore it from git"]]
               advisory [["xcrun (Xcode), needed to build for the phone" (fs/which "xcrun")]
                         ["UDID set, needed to install on the phone" (System/getenv "UDID")]]]
           (doseq [[what ok fix] required]
             (println (str (if ok "  ok      " "  MISSING ") what (when-not ok (str "  -> " fix)))))
           (doseq [[what ok] advisory]
             (println (str (if ok "  ok      " "  note    ") what (when-not ok "  (not set up here)"))))
           (when jolt?
             (println (str "  jolt    " (str/trim (:out (shell {:out :string :continue true} jolt-cmd "--version"))))))
           (when ios-root
             (println (str "  raylib-ios at " ios-root)))
           (when-not (every? second required) (System/exit 1)))}

  gen
  {:doc "Rebuild deps.edn, the sub-projects, the registry and these tasks from demos.edn: gen [--check]"
   :requires ([gen])
   :task (apply gen/-main *command-line-args*)}

