{;; Shared by every scene: the raylib-ios platform (the host loop, the single-scene
 ;; runner, the iOS build tools) and the demo-side helpers in common/src.
 ;;
 ;; This is the one place raylib-ios is pinned. To move to a newer raylib-ios,
 ;; change :git/sha to that commit, then run `bb doctor` and the gates. Every
 ;; sub-project depends on common/, so they all get the platform through here,
 ;; and so do tools/ios' build scripts, which each sub-project's tasks find
 ;; through this dependency (scripts/ios_tools.clj).
 :jolt/min-version "0.8.0"
 :paths ["src"]
 :deps {net.b12n/raylib-ios {:git/url "https://github.com/jlt-commons/raylib-ios.git"
                              :git/sha "56919330a05642c482c7d79648a1b04ac739a042"}}}
